# Скопируйте в .env. Значения ниже — пример, заполните для своей установки App.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=

# Репозитории и базовые ветки выбираются через интерфейс, а не задаются в .env.

# API, модель и параметры генерации: ai.config.json в корне проекта.
# Ключ нужен только для сервера ИИ с Bearer-авторизацией. Для локальной LM Studio оставьте пустым.
AI_API_KEY=
PORT=3000
# Один процесс сервера на один каталог данных.
DATA_DIR=.data

# Необязательный вход. Оставьте все три пустыми для локальной работы без входа.
# При заполнении хотя бы одного поля API закрывается до полной настройки.
# Для связи профиля с демо-сотрудником логин: karina или sofia.
DEMO_USERNAME=
DEMO_PASSWORD=
SESSION_SECRET=
# Случайный секрет длиной не менее 32 символов; тот же секрет укажите в GitHub webhook.
GITHUB_WEBHOOK_SECRET=

# Общая доска через Tailscale Serve: точный https://computer.tailnet.ts.net, без слеша.
# Оставьте пустым для прежнего локального режима. Требуется полностью настроенный вход.
SHARED_ORIGIN=
