# Скопируйте в .env. Значения ниже — пример, заполните для своей установки App.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=

# Репозитории и базовые ветки выбираются через интерфейс, а не задаются в .env.

# Идентификатор модели должен совпадать с загруженной моделью LM Studio.
LM_STUDIO_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
LM_STUDIO_MODEL=qwen/qwen3.5-9b
# Необязательный Bearer-ключ для облачного Chat Completions API.
AI_API_KEY=
PORT=3000
# Один процесс сервера на один каталог данных.
DATA_DIR=.data

# Необязательный вход. Оставьте все три пустыми для локальной работы без входа.
# При заполнении хотя бы одного поля API закрывается до полной настройки.
# Для связи профиля с демо-сотрудником логин: karina или sofia.
DEMO_USERNAME=
DEMO_PASSWORD=
SESSION_SECRET=
# Случайный секрет длиной не менее 32 символов; тот же секрет укажите в GitHub webhook.
GITHUB_WEBHOOK_SECRET=
